# Copy to .env and fill in required secrets. Docker Compose loads .env automatically.
# Mix does not load .env; see README.md for local development instructions.

# Required for production. Generate SECRET_KEY_BASE with: mix phx.gen.secret
SECRET_KEY_BASE=
XEBA_AUTH_USERNAME=
XEBA_AUTH_PASSWORD=

# Replace with the public HTTPS hostname, without scheme or port.
PHX_HOST=xeba.example.com
TZ=Europe/Rome

# Required for the Telegram connection and AI replies.
EXIRON_BASE_URL=https://your-exiron-host
EXIRON_HOOK_TOKEN=
EXIRON_CLIENT_ID=xeba
TELEGRAM_BOT_NAME=xeba
AI_API_KEY=
AI_MODEL=google:gemini-3.6-flash
# Leave empty for native providers; otherwise use a Chat Completions API base URL.
AI_ENDPOINT=

# Production uses DATABASE_URL when non-empty, otherwise the individual settings.
DATABASE_URL=
# Use localhost when running Mix on the host. In Docker, use the database's DNS name.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Optional database name; defaults to xeba_dev. Ignored when DATABASE_URL is set.
POSTGRES_DB=xeba_dev
POSTGRES_TEST_DB=xeba_test
POSTGRES_POOL_SIZE=10
