<!DOCTYPE html>
<html lang="en" data-theme="dark" data-connection-status="connecting">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#07100e" />
    <.live_title default="Xeba" suffix=" · Control room" phx-no-format>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <% current_path = assigns[:conn] && assigns[:conn].request_path %>
    <% console_active? =
      current_path == "/" || String.starts_with?(current_path || "", "/chats/") %>
    <% automation_active? = current_path == "/autonomous" %>
    <nav
      id="auth-navigation"
      class="sticky top-0 z-40 flex h-[3.25rem] w-full items-center border-b border-white/[0.08] bg-[#07100e]/85 px-3 text-sm text-stone-300 shadow-[0_1px_0_rgba(255,255,255,0.02)] backdrop-blur-xl sm:px-5"
    >
      <div class="mx-auto flex w-full max-w-7xl items-center gap-2">
        <.link href={~p"/"} class="group flex shrink-0 items-center gap-2.5 pr-2">
          <span class="grid size-7 place-items-center rounded-lg border border-emerald-300/20 bg-emerald-300/10 shadow-[0_0_20px_rgba(52,211,153,0.08)] transition group-hover:border-emerald-300/35 group-hover:bg-emerald-300/15">
            <.icon name="hero-paper-airplane-solid" class="size-3.5 text-emerald-300" />
          </span>
          <span class="font-semibold tracking-tight text-white">Xeba</span>
        </.link>

        <%= if @current_scope do %>
          <div class="ml-1 flex items-center gap-1 border-l border-white/10 pl-2">
            <.link
              href={~p"/"}
              aria-current={console_active? && "page"}
              class={[
                "inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-xs font-medium transition",
                console_active? &&
                  "bg-white/[0.07] text-white shadow-[inset_0_0_0_1px_rgba(255,255,255,0.05)]",
                !console_active? && "text-stone-400 hover:bg-white/5 hover:text-white"
              ]}
            >
              <.icon name="hero-command-line" class="size-3.5" />
              <span class="hidden sm:inline">Console</span>
            </.link>
            <.link
              href={~p"/autonomous"}
              aria-current={automation_active? && "page"}
              class={[
                "inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-xs font-medium transition",
                automation_active? &&
                  "bg-white/[0.07] text-white shadow-[inset_0_0_0_1px_rgba(255,255,255,0.05)]",
                !automation_active? && "text-stone-400 hover:bg-white/5 hover:text-white"
              ]}
            >
              <.icon name="hero-clock" class="size-3.5" />
              <span class="hidden sm:inline">Automation</span>
            </.link>
          </div>
          <div class="ml-auto flex items-center gap-2">
            <span
              id="connection-status"
              aria-live="polite"
              title="Realtime connection to the Xeba server"
              class="hidden items-center gap-1.5 rounded-full border px-2 py-1 text-[0.65rem] font-medium transition sm:inline-flex"
            >
              <span class="connection-dot size-1.5 rounded-full"></span>
              <span class="connection-state connection-state-connecting">Connecting</span>
              <span class="connection-state connection-state-connected">Online</span>
              <span class="connection-state connection-state-offline">Offline</span>
            </span>
            <span class="hidden max-w-[12rem] truncate text-xs text-stone-500 md:inline">
              {@current_scope.user.username}
            </span>
            <.link
              href={~p"/log-out"}
              method="delete"
              class="inline-flex items-center gap-1.5 rounded-lg border border-white/10 px-2.5 py-1.5 text-xs font-medium text-stone-300 transition hover:border-rose-300/25 hover:bg-rose-300/[0.07] hover:text-white"
            >
              <.icon name="hero-arrow-right-start-on-rectangle" class="size-3.5" />
              <span class="hidden sm:inline">Log out</span>
            </.link>
          </div>
        <% else %>
          <span class="ml-auto inline-flex items-center gap-1.5 text-xs text-stone-500">
            <.icon name="hero-lock-closed" class="size-3.5" /> Private console
          </span>
        <% end %>
      </div>
    </nav>
    {@inner_content}
  </body>
</html>
